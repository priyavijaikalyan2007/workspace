{
    "name": "outcrop-workspace",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "license": "GPL-3.0-or-later",
    "packageManager": "npm@11.20.0",
    "engines": {
        "node": "26.12.1",
        "npm": "11.20.0"
    },
    "workspaces": [
        "src/tool/workspace-build",
        "src/extensions/googleworkspace/*"
    ],
    "scripts": {
        "test": "vitest run --coverage",
        "typecheck": "tsc --noEmit && tsc -p test/experiments/docs-input/tsconfig.json",
        "lint": "eslint src/tool/workspace-build test/experiments/docs-input vitest.config.ts eslint.config.mjs",
        "test:shell": "bats test/shell",
        "test:instructions": "python3 -m unittest discover -s scripts/tests -q"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/google-apps-script": "2.0.14",
        "@types/node": "26.6.6",
        "@types/semver": "7.8.0",
        "@vitest/coverage-v8": "5.0.5",
        "bats": "1.13.0",
        "esbuild": "0.28.2",
        "eslint": "10.14.0",
        "semver": "7.8.5",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "vitest": "5.0.5"
    },
    "overrides": {
        "minimatch": "11.0.1"
    }
}
